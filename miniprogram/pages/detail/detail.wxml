<view class="title">订单 #{{order.id}}</view><view class="card" wx:if="{{order.id}}"><view class="row"><text>型号</text><text>{{order.model}}</text></view><view class="row"><text>完整串码</text><text>{{order.serial}}</text></view><view class="row"><text>后六位</text><text>{{order.serial_last6}}</text></view><view class="row"><text>客户</text><text>{{order.customer}}</text></view><view class="row"><text>状态</text><text>{{order.status_label}}</text></view></view><view class="card" wx:for="{{order.items}}" wx:key="id"><view class="row"><text>项目 #{{item.id}} · {{item.plan}}</text><text class="tag">{{item.status_label}}</text></view><view class="row" wx:if="{{!isTech}}"><text>客户收费</text><text>¥{{item.charge_yuan}}</text></view><view class="row"><text>师傅工价</text><text>¥{{item.wage_yuan}}</text></view><view class="row"><text>师傅 / 等级</text><text>{{item.technician_name}} / {{item.vip_level}}</text></view><view wx:if="{{item.completed_at}}" class="muted">完成时间：{{item.completed_at}}</view><button wx:if="{{isTech && item.status==='pending' && order.status==='active'}}" class="btn" data-id="{{item.id}}" bindtap="complete">已修好</button><button wx:if="{{!isTech && !item.superseded_by && (item.status==='pending' || item.status==='completed') && order.status==='active'}}" data-id="{{item.id}}" bindtap="reassign">重新派单</button></view><view class="card" wx:if="{{!isTech && order.status==='active'}}"><button class="btn" bindtap="addItem">追加维修项目</button><button class="danger" bindtap="returnOrder">退机</button><button class="danger" bindtap="cancelOrder">取消订单</button></view>
<view class="card" wx:if="{{assignItem}}"><view class="title">转派 · {{assignItem.plan}}</view><view class="muted">{{assignItem.status==='completed'?'原工价全额扣回，新师傅完成后结算。':'改派后由新师傅处理。'}}客户收费不变。</view><view class="label">新师傅</view><picker range="{{assignNames}}" value="{{assignIndex}}" bindchange="chooseAssign"><view class="input">{{assignIndex>=0?assignNames[assignIndex]:'请选择师傅'}}</view></picker><view class="label">转派原因</view><input class="input" value="{{assignReason}}" maxlength="200" bindinput="assignReason" placeholder="例如：返修过多、请假、客户催急"/><button class="btn" bindtap="submitAssign" loading="{{assignBusy}}" disabled="{{assignBusy}}">确认转派</button><button bindtap="cancelAssign" disabled="{{assignBusy}}">取消</button></view>

<view class="card" wx:for="{{order.deductions}}" wx:key="id"><view class="title">本单责任扣款 · {{item.kind}}</view><view>扣款 ¥{{item.amount_yuan}} · 已扣 ¥{{item.paid_yuan}} · 待扣 ¥{{item.pending_yuan}}</view><view class="muted">原因：{{item.reason}}</view></view>
