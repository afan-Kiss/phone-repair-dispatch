<view class="title">{{orderId?'追加维修项目':'设备入库'}}</view><view class="card"><view wx:if="{{!orderId}}"><view class="label">完整串码</view><input class="input" value="{{form.serial}}" data-key="serial" bindinput="input" bindblur="lookup" placeholder="扫描或输入完整串码"/><button bindtap="scanSerial">扫码</button><view class="muted">后六位：{{last6}}</view><view class="label">型号</view><input class="input" value="{{form.model}}" data-key="model" bindinput="input" placeholder="手机型号"/><view class="label">客户信息</view><input class="input" value="{{form.customer}}" data-key="customer" bindinput="input" placeholder="客户姓名或联系方式"/></view><view class="label">维修方案</view><input class="input" value="{{form.plan}}" data-key="plan" bindinput="input" placeholder="维修方案"/><view class="label">客户收费（元）</view><input class="input" type="digit" value="{{form.charge}}" data-key="charge" bindinput="input"/><view class="label">师傅工价（元）</view><input class="input" type="digit" value="{{form.wage}}" data-key="wage" bindinput="input"/><view class="label">指派师傅</view><picker range="{{techNames}}" bindchange="chooseTech"><view class="input">{{selectedTech||'请选择师傅'}}</view></picker><view class="muted">师傅等级：{{selectedVip}}</view><button class="btn" bindtap="submit" loading="{{loading}}">{{orderId?'追加项目':'入库并派单'}}</button></view>
