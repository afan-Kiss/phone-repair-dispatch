page { min-height: 100%; padding-bottom: 36rpx; background: #f3f8fb; color: #193447; font-family: -apple-system, BlinkMacSystemFont, "Microsoft YaHei", sans-serif; }
view, text, input, button { box-sizing: border-box; }
.title { margin: 30rpx 28rpx 20rpx; font-size: 40rpx; font-weight: 800; line-height: 1.35; }
.card { margin: 18rpx 22rpx; padding: 28rpx; background: #fff; border: 1rpx solid #e2edf2; border-radius: 22rpx; box-shadow: 0 8rpx 30rpx rgba(20, 58, 78, .06); overflow: hidden; }
.muted { color: #6c8290; font-size: 25rpx; line-height: 1.5; word-break: break-all; }
.label { margin-top: 14rpx; color: #294456; font-size: 26rpx; font-weight: 700; }
.input { display: flex; align-items: center; width: 100%; min-height: 84rpx; margin: 12rpx 0 24rpx; padding: 16rpx 20rpx; border: 1rpx solid #cadce5; border-radius: 14rpx; background: #fff; color: #193447; font-size: 29rpx; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; min-height: 76rpx; padding: 14rpx 0; border-bottom: 1rpx solid #ebf1f4; font-size: 27rpx; }
.row:last-child { border-bottom: 0; }
.row text:first-child { flex: 0 1 auto; min-width: 0; word-break: break-all; }
.row text:last-child { flex: 0 1 auto; max-width: 65%; text-align: right; word-break: break-all; }
.tag { display: inline-block; flex-shrink: 0; padding: 7rpx 16rpx; border-radius: 40rpx; background: #e7f4f9; color: #176d91; font-size: 23rpx; font-weight: 700; white-space: nowrap; }
button { min-height: 84rpx; margin: 14rpx 0 0; border: 0; border-radius: 14rpx; background: #e9f4f8; color: #196b8b; font-size: 27rpx; font-weight: 700; line-height: 84rpx; }
button::after { border: 0; }
button.btn { background: #167fa5; color: #fff; }
button.danger { background: #fceced; color: #a73c4b; }
.actionGrid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.actionGrid button { margin-top: 12rpx; }
.actionGrid .primaryWide { grid-column: 1 / -1; }
.modeTabs { display: flex; gap: 10rpx; margin-bottom: 28rpx; padding: 8rpx; border-radius: 16rpx; background: #edf5f8; }
.modeTabs text { flex: 1; padding: 18rpx 10rpx; border-radius: 12rpx; text-align: center; color: #6b8593; font-weight: 700; }
.modeTabs .active { background: #fff; color: #167fa5; box-shadow: 0 3rpx 12rpx rgba(20, 58, 78, .08); }
.statCard { background: linear-gradient(135deg, #fff, #eef8fb); }
.statCard .statValue { color: #126e91; font-size: 42rpx; font-weight: 800; }
@media (max-width: 360px) { .card { margin: 14rpx 16rpx; padding: 22rpx; } .title { margin-left: 20rpx; } .row { font-size: 25rpx; } }

.loginPage { min-height: 100vh; padding: 70rpx 16rpx 40rpx; background: linear-gradient(160deg, #dceff6, #f4f8fb 65%); }
.loginHero { padding: 10rpx 28rpx 42rpx; text-align: center; }
.loginMark { width: 100rpx; height: 100rpx; margin: 0 auto 28rpx; border-radius: 30rpx; background: linear-gradient(135deg, #168aac, #145b7c); color: #fff; font-size: 56rpx; font-weight: 800; line-height: 100rpx; box-shadow: 0 12rpx 28rpx rgba(21,127,165,.2); }
.loginTitle { font-size: 42rpx; font-weight: 800; color: #183f55; }
.loginSubtitle { margin-top: 14rpx; font-size: 26rpx; color: #658494; }
.loginCard { padding: 38rpx 34rpx; border-radius: 30rpx; box-shadow: 0 20rpx 60rpx rgba(20,58,78,.09); }
.loginWelcome { font-size: 36rpx; font-weight: 800; }
.loginDescription { margin: 12rpx 0 30rpx; font-size: 25rpx; color: #6c8290; }
.loginCard .input { background: #f7fafc; min-height: 94rpx; border-radius: 18rpx; }
.loginCard button.btn { margin-top: 34rpx; border-radius: 18rpx; background: linear-gradient(110deg, #1786aa, #146b90); }
.loginCard button[disabled] { opacity: .6; }
.loginHint { margin-top: 24rpx; font-size: 24rpx; line-height: 1.7; color: #6c8290; }
.loginFooter { margin: 32rpx 0; text-align: center; color: #8198a4; font-size: 23rpx; }

/* 长串码、项目名称和按钮文案保持在内容区域内。 */
view, text, button, picker { min-width: 0; }
.card, .title, .loginHero { overflow-wrap: anywhere; word-break: break-all; }
.input { max-width: 100%; word-break: break-all; }
button { max-width: 100%; padding: 20rpx 24rpx; line-height: 1.6; white-space: normal; word-break: break-all; }
.modeTabs { flex-wrap: wrap; }
.modeTabs text { min-width: 120rpx; word-break: break-all; }
.row { flex-wrap: wrap; }
.row .tag { max-width: 100%; white-space: normal; word-break: break-all; }
page { padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); }
/* 平板保持可读字号与适当内容宽度，避免 rpx 随大屏过度放大。 */
@media (min-width: 768px) {
  page { font-size: 16px; }
  .card { max-width: 720px; margin: 18px auto; padding: 24px; border-radius: 18px; }
  .title { max-width: 720px; margin: 26px auto 18px; font-size: 28px; }
  .muted, .loginDescription, .loginHint, .loginSubtitle { font-size: 15px; }
  .label, .row, button { font-size: 16px; }
  .input { min-height: 48px; margin: 10px 0 18px; padding: 12px; font-size: 16px; border-radius: 10px; }
  .row { min-height: 48px; gap: 12px; padding: 12px 0; }
  .tag { padding: 5px 10px; font-size: 14px; }
  button { min-height: 48px; padding: 12px 16px; margin-top: 12px; border-radius: 10px; }
  .actionGrid, .modeTabs { gap: 10px; }
  .modeTabs { padding: 6px; margin-bottom: 20px; }
  .modeTabs text { padding: 12px; }
  .statCard .statValue { font-size: 30px; }
  .loginPage { padding: 40px 20px; }
  .loginHero { padding: 10px 20px 28px; }
  .loginMark { width: 64px; height: 64px; margin-bottom: 20px; font-size: 36px; line-height: 64px; border-radius: 20px; }
  .loginTitle { font-size: 28px; }
  .loginWelcome { font-size: 24px; }
  .loginCard { max-width: 460px; padding: 28px; }
  .loginCard .input { min-height: 50px; }
  .loginCard button.btn { margin-top: 22px; }
  .loginFooter { margin: 24px 0; font-size: 14px; }
}
